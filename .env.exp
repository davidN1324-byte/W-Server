# ── Auth ──
ACCESS_TOKEN=

# ── Encryption ──
# Generate: python3 -c "from cryptography.hazmat.primitives.ciphers.aead import AESGCM; import base64; 
# print('ENCRYPTION_KEY=' + base64.urlsafe_b64encode(AESGCM.generate_key(bit_length=256)).decode())"
ENCRYPTION_KEY=

# ── Upload limits ──
MAX_CONTENT_LENGTH=104857600
ALLOWED_EXTENSIONS=txt,pdf,png,jpg,jpeg,gif
ALLOWED_MIMES=text/plain,application/pdf,image/png,image/jpeg,image/gif

# ── Server ──
PORT=5000
MAX_CONNECTIONS=10

# ── Auto-delete (0 = disabled) ──
FILE_TTL_HOURS=0